+#ifdef MILVUS_STORAGE_NO_EXTERNAL_FORMATS
+
+#include <gtest/gtest.h>
+
+#include <arrow/filesystem/localfs.h>
+
+#include "milvus-storage/common/config.h"
+#include "milvus-storage/format/format.h"
+#include "milvus-storage/lob_column/lob_column_manager.h"
+#include "milvus-storage/lob_column/lob_column_reader.h"
+#include "milvus-storage/lob_column/lob_column_writer.h"
+#include "milvus-storage/lob_column/lob_reference.h"
+
+namespace milvus_storage {
+
+TEST(ExternalFormatsDisabled, RemovedFormatsReturnNotImplemented) {
+  for (const auto* format :
+       {LOON_FORMAT_VORTEX, LOON_FORMAT_LANCE_TABLE, LOON_FORMAT_ICEBERG_TABLE, LOON_FORMAT_PAIMON_TABLE}) {
+    auto result = Format::get(format);
+    ASSERT_FALSE(result.ok()) << format;
+    EXPECT_TRUE(result.status().IsNotImplemented()) << result.status().ToString();
+    EXPECT_NE(result.status().message().find("WITH_EXTERNAL_TABLE_FORMATS=OFF"), std::string::npos);
+  }
+}
+
+TEST(ExternalFormatsDisabled, ParquetRemainsAvailable) { EXPECT_TRUE(Format::get(LOON_FORMAT_PARQUET).ok()); }
+
+TEST(ExternalFormatsDisabled, UnknownFormatIsStillInvalid) {
+  auto result = Format::get("no-such-format");
+  ASSERT_FALSE(result.ok());
+  EXPECT_TRUE(result.status().IsInvalid()) << result.status().ToString();
+}
+
+class LobWithoutVortexTest : public ::testing::Test {
+  protected:
+  void SetUp() override {
+    dir_ = ::testing::TempDir() + "lob_without_vortex_" +
+           std::to_string(reinterpret_cast<uintptr_t>(this));
+    fs_ = std::make_shared<arrow::fs::LocalFileSystem>();
+    ASSERT_TRUE(fs_->CreateDir(dir_, true).ok());
+    config_.lob_base_path = dir_;
+    config_.data_type = lob_column::LobDataType::kText;
+    config_.inline_threshold = 64;
+  }
+  void TearDown() override { (void)fs_->DeleteDir(dir_); }
+
+  std::string dir_;
+  std::shared_ptr<arrow::fs::FileSystem> fs_;
+  lob_column::LobColumnConfig config_;
+};
+
+// Values under the inline threshold never touch a LOB file, so they still work.
+TEST_F(LobWithoutVortexTest, InlineValuesRoundTrip) {
+  auto writer_result = lob_column::CreateLobColumnWriter(fs_, config_);
+  ASSERT_TRUE(writer_result.ok()) << writer_result.status().ToString();
+  auto writer = std::move(writer_result).ValueOrDie();
+  const std::string text = "short text";
+  auto encoded = writer->WriteData(reinterpret_cast<const uint8_t*>(text.data()), text.size());
+  ASSERT_TRUE(encoded.ok()) << encoded.status().ToString();
+  auto files = writer->Close();
+  ASSERT_TRUE(files.ok()) << files.status().ToString();
+  EXPECT_TRUE(files->empty());
+
+  auto reader_result = lob_column::CreateLobColumnReader(fs_, config_);
+  ASSERT_TRUE(reader_result.ok()) << reader_result.status().ToString();
+  auto reader = std::move(reader_result).ValueOrDie();
+  auto decoded = reader->ReadData(encoded->data(), encoded->size());
+  ASSERT_TRUE(decoded.ok()) << decoded.status().ToString();
+  EXPECT_EQ(std::string(decoded->begin(), decoded->end()), text);
+}
+
+// Values over the threshold need a Vortex LOB file, which this build refuses.
+TEST_F(LobWithoutVortexTest, LargeValueReturnsNotImplemented) {
+  auto writer_result = lob_column::CreateLobColumnWriter(fs_, config_);
+  ASSERT_TRUE(writer_result.ok()) << writer_result.status().ToString();
+  auto writer = std::move(writer_result).ValueOrDie();
+  const std::string text(1024, 'x');
+  auto encoded = writer->WriteData(reinterpret_cast<const uint8_t*>(text.data()), text.size());
+  ASSERT_FALSE(encoded.ok());
+  EXPECT_TRUE(encoded.status().IsNotImplemented()) << encoded.status().ToString();
+  EXPECT_NE(encoded.status().message().find("WITH_EXTERNAL_TABLE_FORMATS=OFF"), std::string::npos);
+  EXPECT_TRUE(writer->Abort().ok());
+}
+
+}  // namespace milvus_storage
+
+#endif  // MILVUS_STORAGE_NO_EXTERNAL_FORMATS
